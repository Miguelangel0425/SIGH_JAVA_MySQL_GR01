		<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank" isLazy="true"><reportElement x="415" y="40" width="140" height="140"/><box><pen lineWidth="0.5" lineColor="#D6E5E4"/></box><imageExpression><![CDATA[$P{FOTO_RUTA}]]></imageExpression></image>
		<staticText><reportElement x="0" y="40" width="110" height="26" forecolor="#496360"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
