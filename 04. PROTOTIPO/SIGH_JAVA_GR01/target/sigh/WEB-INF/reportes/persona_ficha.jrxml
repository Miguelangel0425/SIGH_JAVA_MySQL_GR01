<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="persona_ficha" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
	<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<parameter name="PERSONA" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<parameter name="FOTO_RUTA" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<queryString><![CDATA[SELECT p.PEPER_CODIGO, p.PEPER_APELLI, p.PEPER_NOMBRE, g.PEGEN_DESCRI, e.PEESC_DESCRI,
       p.PEPER_FECNAC, CAST(p.PEPER_CARFAM AS SIGNED) AS CARGAS, p.PEPER_DISCAPACIDAD, p.PEPER_EMAIL,
       CASE WHEN p.PEPER_CEDULA IS NOT NULL THEN 'Cédula' WHEN p.PEPER_PASAPO IS NOT NULL THEN 'Pasaporte' ELSE '' END AS TIPO_DOC,
       COALESCE(p.PEPER_CEDULA, p.PEPER_PASAPO) AS DOCUMENTO
FROM peper_perso p
JOIN pegen_genero g ON g.PEGEN_CODIGO = p.PEGEN_CODIGO
JOIN peesc_civil e ON e.PEESC_CODIGO = p.PEESC_CODIGO
WHERE p.PEPER_CODIGO = $P{PERSONA}]]></queryString>
	<field name="PEPER_CODIGO" class="java.lang.String"/>
	<field name="PEPER_APELLI" class="java.lang.String"/>
	<field name="PEPER_NOMBRE" class="java.lang.String"/>
	<field name="PEGEN_DESCRI" class="java.lang.String"/>
	<field name="PEESC_DESCRI" class="java.lang.String"/>
	<field name="PEPER_FECNAC" class="java.sql.Date"/>
	<field name="CARGAS" class="java.lang.Integer"/>
	<field name="PEPER_DISCAPACIDAD" class="java.lang.String"/>
	<field name="PEPER_EMAIL" class="java.lang.String"/>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="DOCUMENTO" class="java.lang.String"/>
	<title>
		<band height="64">
			<rectangle><reportElement x="0" y="0" width="555" height="56" forecolor="#0E625C" backcolor="#0E625C"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		<staticText><reportElement x="10" y="6" width="285" height="28" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="18" isBold="true"/></textElement><text><![CDATA[Ficha de persona]]></text></staticText>
		<staticText><reportElement x="10" y="32" width="285" height="18" forecolor="#D2EEE6"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><text><![CDATA[SIGH · Sistema Integral de Gestión Hospitalaria]]></text></staticText>
		<textField isBlankWhenNull="true"><reportElement x="285" y="6" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
		<textField isBlankWhenNull="true"><reportElement x="285" y="21" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression></textField>
		</band>
	</title>
