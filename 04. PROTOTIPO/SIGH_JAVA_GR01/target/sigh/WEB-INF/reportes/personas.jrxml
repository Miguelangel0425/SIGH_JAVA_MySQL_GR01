<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="personas" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
	<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<queryString><![CDATA[SELECT p.PEPER_CODIGO, p.PEPER_APELLI, p.PEPER_NOMBRE, g.PEGEN_DESCRI, e.PEESC_DESCRI,
       COALESCE(p.PEPER_CEDULA, p.PEPER_PASAPO) AS DOCUMENTO,
       CASE WHEN p.PEPER_CEDULA IS NOT NULL THEN 'Cédula' WHEN p.PEPER_PASAPO IS NOT NULL THEN 'Pasaporte' ELSE '' END AS TIPO_DOC,
       p.PEPER_FECNAC
FROM peper_perso p
JOIN pegen_genero g ON g.PEGEN_CODIGO = p.PEGEN_CODIGO
JOIN peesc_civil e ON e.PEESC_CODIGO = p.PEESC_CODIGO
ORDER BY p.PEPER_APELLI, p.PEPER_NOMBRE]]></queryString>
	<field name="PEPER_CODIGO" class="java.lang.String"/>
	<field name="PEPER_APELLI" class="java.lang.String"/>
	<field name="PEPER_NOMBRE" class="java.lang.String"/>
	<field name="PEGEN_DESCRI" class="java.lang.String"/>
	<field name="PEESC_DESCRI" class="java.lang.String"/>
	<field name="DOCUMENTO" class="java.lang.String"/>
	<field name="TIPO_DOC" class="java.lang.String"/>
	<field name="PEPER_FECNAC" class="java.sql.Date"/>
	<title>
		<band height="64">
			<rectangle><reportElement x="0" y="0" width="802" height="56" forecolor="#0E625C" backcolor="#0E625C"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		<staticText><reportElement x="10" y="6" width="532" height="28" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="18" isBold="true"/></textElement><text><![CDATA[Reporte de personas]]></text></staticText>
		<staticText><reportElement x="10" y="32" width="532" height="18" forecolor="#D2EEE6"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><text><![CDATA[SIGH · Sistema Integral de Gestión Hospitalaria]]></text></staticText>
		<textField isBlankWhenNull="true"><reportElement x="532" y="6" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
		<textField isBlankWhenNull="true"><reportElement x="532" y="21" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression></textField>
		</band>
	</title>
	<columnHeader>
		<band height="24">
		<staticText><reportElement x="0" y="0" width="85" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
		<staticText><reportElement x="85" y="0" width="160" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Apellidos]]></text></staticText>
		<staticText><reportElement x="245" y="0" width="160" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Nombres]]></text></staticText>
		<staticText><reportElement x="405" y="0" width="80" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Sexo]]></text></staticText>
