		<staticText><reportElement x="580" y="0" width="130" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Documento]]></text></staticText>
		<staticText><reportElement x="710" y="0" width="92" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Fecha de nac.]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="0" y="0" width="85" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{PEPER_CODIGO}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="85" y="0" width="160" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PEPER_APELLI}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="245" y="0" width="160" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PEPER_NOMBRE}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="405" y="0" width="80" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PEGEN_DESCRI}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="485" y="0" width="95" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PEESC_DESCRI}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="580" y="0" width="130" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[($F{TIPO_DOC}.isEmpty() ? "" : $F{TIPO_DOC} + ": ") + ($F{DOCUMENTO} == null ? "" : $F{DOCUMENTO})]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" pattern="dd/MM/yyyy" isBlankWhenNull="true"><reportElement x="710" y="0" width="92" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PEPER_FECNAC}]]></textFieldExpression></textField>
		</band>
	</detail>
