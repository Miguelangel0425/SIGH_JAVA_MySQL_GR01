<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cargos" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
	<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<parameter name="DEPARTAMENTO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<queryString><![CDATA[SELECT c.PEDEP_CODIGO, d.PEDEP_DESCRIP, c.PECAR_CODIGO, c.PECAR_DESCRI
FROM pecar_cargo c
JOIN pedep_depar d ON d.PEDEP_CODIGO = c.PEDEP_CODIGO
WHERE $P{DEPARTAMENTO} = '' OR c.PEDEP_CODIGO = $P{DEPARTAMENTO}
ORDER BY c.PEDEP_CODIGO, c.PECAR_CODIGO]]></queryString>
	<field name="PEDEP_CODIGO" class="java.lang.String"/>
	<field name="PEDEP_DESCRIP" class="java.lang.String"/>
	<field name="PECAR_CODIGO" class="java.lang.String"/>
	<field name="PECAR_DESCRI" class="java.lang.String"/>
	<variable name="CargosDepartamento" class="java.lang.Integer" resetType="Group" resetGroup="Departamento" calculation="Count"><variableExpression><![CDATA[$F{PECAR_CODIGO}]]></variableExpression></variable>
	<group name="Departamento">
		<groupExpression><![CDATA[$F{PEDEP_CODIGO}]]></groupExpression>
		<groupHeader>
			<band height="26">
		<textField isBlankWhenNull="true"><reportElement x="0" y="2" width="555" height="22" forecolor="#FFFFFF" mode="Opaque" backcolor="#0E625C"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{PEDEP_CODIGO} + " - " + $F{PEDEP_DESCRIP}]]></textFieldExpression></textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="26">
		<textField isBlankWhenNull="true"><reportElement x="0" y="2" width="555" height="18" forecolor="#496360"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Cargos en el departamento: " + $V{CargosDepartamento}]]></textFieldExpression></textField>
			</band>
		</groupFooter>
	</group>
	<title>
		<band height="64">
			<rectangle><reportElement x="0" y="0" width="555" height="56" forecolor="#0E625C" backcolor="#0E625C"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		<staticText><reportElement x="10" y="6" width="285" height="28" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="18" isBold="true"/></textElement><text><![CDATA[Reporte de cargos]]></text></staticText>
		<staticText><reportElement x="10" y="32" width="285" height="18" forecolor="#D2EEE6"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><text><![CDATA[SIGH · Sistema Integral de Gestión Hospitalaria]]></text></staticText>
		<textField isBlankWhenNull="true"><reportElement x="285" y="6" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
		<textField isBlankWhenNull="true"><reportElement x="285" y="21" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression></textField>
		<textField isBlankWhenNull="true"><reportElement x="285" y="36" width="262" height="16" forecolor="#FFFFFF"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{DEPARTAMENTO}.isEmpty() ? "Todos los departamentos" : "Departamento: " + $P{DEPARTAMENTO}]]></textFieldExpression></textField>
		</band>
	</title>
	<columnHeader>
		<band height="24">
		<staticText><reportElement x="0" y="0" width="110" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
		<staticText><reportElement x="110" y="0" width="445" height="24" forecolor="#0E625C" mode="Opaque" backcolor="#E7F2F1"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Descripción del cargo]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
		<textField isBlankWhenNull="true"><reportElement x="0" y="0" width="110" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{PEDEP_CODIGO} + $F{PECAR_CODIGO}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="110" y="0" width="445" height="22" forecolor="#123533"/><box leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D6E5E4"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PECAR_DESCRI}]]></textFieldExpression></textField>
		</band>
	</detail>
	<pageFooter>
		<band height="22">
		<textField isBlankWhenNull="true"><reportElement x="435" y="2" width="100" height="18" forecolor="#496360"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression></textField>
		<textField evaluationTime="Report" isBlankWhenNull="true"><reportElement x="535" y="2" width="20" height="18" forecolor="#496360"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression></textField>
		<staticText><reportElement x="0" y="2" width="300" height="18" forecolor="#496360"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><text><![CDATA[Hospital · SIGH]]></text></staticText>
		</band>
	</pageFooter>
	<summary>
		<band height="30">
		<textField isBlankWhenNull="true"><reportElement x="0" y="6" width="555" height="20" forecolor="#0E625C"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de cargos: " + $V{REPORT_COUNT}]]></textFieldExpression></textField>
		</band>
	</summary>
	<noData>
		<band height="40">
		<staticText><reportElement x="0" y="8" width="555" height="24" forecolor="#496360"/><box leftPadding="5" rightPadding="5"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement><text><![CDATA[No hay datos para mostrar.]]></text></staticText>
		</band>
	</noData>
</jasperReport>
